module checker::xxh3_test;

import checker::xxh3;
import std::io::file;

fn void check_pattern(sz len, char[16] expected)
{
    char[1024] input;
    for (sz i = 0; i < input.len; i++) input[i] = (char)(i % 256);
    char[16] actual = xxh3::hash128(input[:len]);
    test::@check(actual[..] == expected[..], "length %d", len);
}

fn void test_pinned_length_classes() @test
{
    check_pattern(0,   { 0x99, 0xaa, 0x06, 0xd3, 0x01, 0x47, 0x98, 0xd8, 0x60, 0x01, 0xc3, 0x24, 0x46, 0x8d, 0x49, 0x7f });
    check_pattern(1,   { 0xa6, 0xcd, 0x5e, 0x93, 0x92, 0x00, 0x0f, 0x6a, 0xc4, 0x4b, 0xdf, 0xf4, 0x07, 0x4e, 0xec, 0xdb });
    check_pattern(3,   { 0xe3, 0xb5, 0x5f, 0x57, 0x94, 0x5a, 0x17, 0xcf, 0x5f, 0x42, 0x99, 0xfc, 0x16, 0x1c, 0x9c, 0xbb });
    check_pattern(16,  { 0x72, 0x95, 0x06, 0x31, 0x82, 0x76, 0x07, 0xe2, 0x84, 0x28, 0x12, 0xcc, 0x87, 0x0d, 0xca, 0xe2 });
    check_pattern(17,  { 0x68, 0x5b, 0xc4, 0x58, 0xb3, 0x7d, 0x05, 0x7f, 0xc0, 0x6e, 0x23, 0x3d, 0xf7, 0x72, 0x92, 0x17 });
    check_pattern(64,  { 0x9c, 0x6e, 0x14, 0x0a, 0x46, 0x55, 0x45, 0xe5, 0x90, 0xc1, 0x97, 0x1d, 0xdb, 0x04, 0xce, 0x74 });
    check_pattern(128, { 0x14, 0x79, 0x2f, 0xc3, 0xaf, 0x88, 0xdc, 0x6c, 0x05, 0x32, 0x1a, 0x0b, 0x64, 0xd6, 0x7b, 0x41 });
    check_pattern(129, { 0xdd, 0x5e, 0x74, 0xac, 0x6b, 0x45, 0xf5, 0x4e, 0xbc, 0x30, 0xb6, 0x33, 0x82, 0xb0, 0x9a, 0x3b });
    check_pattern(240, { 0x65, 0xb5, 0xbe, 0x86, 0xda, 0x55, 0x40, 0xe7, 0xc9, 0x2b, 0x68, 0xe1, 0x6f, 0x83, 0xbb, 0xb6 });
    check_pattern(241, { 0x1d, 0xa1, 0xcb, 0x61, 0xbc, 0xb8, 0xa2, 0xa1, 0x02, 0xe8, 0xcd, 0x95, 0x42, 0x1c, 0x6d, 0x02 });
    check_pattern(512, { 0x11, 0x1d, 0x57, 0x71, 0xdf, 0x64, 0xcb, 0xcb, 0x10, 0x59, 0x10, 0x5a, 0xd1, 0x9b, 0xfa, 0x09 });
    check_pattern(1024,{ 0x83, 0x88, 0x5e, 0x85, 0x3b, 0xb6, 0x64, 0x0c, 0xa8, 0x70, 0xf9, 0x29, 0x84, 0x39, 0x8d, 0x22 });
}

fn void test_golden_certificate_header_anchor() @test
{
    char[] certificate = file::load_temp("../certschema/vectors/golden-terminal-winx.utc")!!;
    char[16] expected = { 0x28, 0x58, 0x56, 0xee, 0x77, 0x31, 0x4b, 0x80, 0xf2, 0x44, 0x04, 0x52, 0xc9, 0x74, 0x63, 0xbd };
    char[16] actual = xxh3::hash128(certificate[:189]);
    test::eq(expected[..], actual[..]);
}
