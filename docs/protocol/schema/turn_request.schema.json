{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poor Man's UTTT turn request",
  "type": "object",
  "$defs": {
    "move": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 8},
        {"type": "integer", "minimum": 0, "maximum": 8}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "board": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[.XO]{9}$"},
      "minItems": 9,
      "maxItems": 9
    },
    "budgets": {
      "type": "object",
      "required": ["X", "O"],
      "properties": {
        "X": {"type": "integer", "minimum": 0},
        "O": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "required": ["type", "protocol", "game_id", "request_id", "ply", "attempt", "you", "board", "forced", "legal", "budgets", "tie_owner", "time_ms"],
  "properties": {
    "type": {"const": "turn"},
    "protocol": {"const": 1},
    "game_id": {"type": "string"},
    "request_id": {"type": "string"},
    "ply": {"type": "integer", "minimum": 0},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "you": {"enum": ["X", "O"]},
    "board": {"$ref": "#/$defs/board"},
    "forced": {"type": ["integer", "null"], "minimum": 0, "maximum": 8},
    "legal": {"type": "array", "items": {"$ref": "#/$defs/move"}},
    "budgets": {"$ref": "#/$defs/budgets"},
    "tie_owner": {"enum": ["X", "O", null]},
    "time_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
